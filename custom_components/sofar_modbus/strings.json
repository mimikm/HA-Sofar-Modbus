  "services": {
    "set_passive": {
      "name": "Set passive mode",
      "description": "Write desired grid power and battery min/max power together, then switch to passive mode. Battery: + charge, - discharge. Grid: + import, - export.",
      "fields": {
        "config_entry_id": {
          "name": "Inverter",
          "description": "Leave empty if you only have one."
        },
        "grid_power": {
          "name": "Desired grid power",
          "description": "+ import from grid, - export."
        },
        "battery_min": {
          "name": "Minimum battery power",
          "description": "+ charge, - discharge."
        },
        "battery_max": {
          "name": "Maximum battery power",
          "description": "+ charge, - discharge."
        },
        "device_id": {
          "name": "Device",
          "description": "Sofar device (alternative to choosing the inverter)."
        }
      }
    },
    "battery_action": {
      "name": "Battery action",
      "description": "Force charge, force discharge, pause, hold, or return to self-use.",
      "fields": {
        "config_entry_id": {
          "name": "Inverter",
          "description": "Leave empty if you only have one."
        },
        "action": {
          "name": "Action",
          "description": "What the battery should do. Also accepted as \"operation\", and short names work: self_use, force_charge, force_discharge, pause, freeze_charge, freeze_discharge."
        },
        "power": {
          "name": "Power",
          "description": "Charge/discharge power in W. Defaults to the Battery action power number."
        },
        "target_soc": {
          "name": "Target SOC",
          "description": "Charge: stop at this SOC. Discharge: stop at this SOC. The battery then holds (no discharge)."
        },
        "device_id": {
          "name": "Device",
          "description": "Sofar device (alternative to choosing the inverter)."
        }
      }
    },
    "scan_registers": {
      "name": "Scan registers",
      "description": "Read every known register range (or one range) and save a dump to the config folder.",
      "fields": {
        "config_entry_id": {
          "name": "Inverter",
          "description": "Leave empty if you only have one."
        },
        "start": {
          "name": "Start address",
          "description": "Decimal start address (e.g. 1600 = 0x0640). Leave empty for a full scan."
        },
        "count": {
          "name": "Count",
          "description": "Number of registers from the start address."
        },
        "device_id": {
          "name": "Device",
          "description": "Sofar device (alternative to choosing the inverter)."
        }
      }
    },
    "charge_slot": {
      "name": "Add charge slot",
      "description": "Force-charge the battery during a time window (Home Assistant-driven, passive mode). Returns to Auto when the slot ends.",
      "fields": {
        "config_entry_id": {
          "name": "Inverter",
          "description": "Leave empty if you only have one."
        },
        "start": {
          "name": "Start",
          "description": "Time (HH:MM) or date and time."
        },
        "end": {
          "name": "End",
          "description": "Time (HH:MM) or date and time. Overnight windows are fine."
        },
        "power": {
          "name": "Power",
          "description": "W. Defaults to the Battery action power number."
        },
        "soc": {
          "name": "SOC limit",
          "description": "Charge: stop at this SOC. Discharge: stop at this SOC. The battery then holds until the slot ends."
        },
        "daily": {
          "name": "Repeat daily",
          "description": "Run every day instead of once."
        },
        "device_id": {
          "name": "Device",
          "description": "Sofar device (alternative to choosing the inverter)."
        }
      }
    },
    "discharge_slot": {
      "name": "Add discharge slot",
      "description": "Force-discharge the battery during a time window (Home Assistant-driven, passive mode). Returns to Auto when the slot ends.",
      "fields": {
        "config_entry_id": {
          "name": "Inverter",
          "description": "Leave empty if you only have one."
        },
        "start": {
          "name": "Start",
          "description": "Time (HH:MM) or date and time."
        },
        "end": {
          "name": "End",
          "description": "Time (HH:MM) or date and time. Overnight windows are fine."
        },
        "power": {
          "name": "Power",
          "description": "W. Defaults to the Battery action power number."
        },
        "soc": {
          "name": "SOC limit",
          "description": "Charge: stop at this SOC. Discharge: stop at this SOC. The battery then holds until the slot ends."
        },
        "daily": {
          "name": "Repeat daily",
          "description": "Run every day instead of once."
        },
        "device_id": {
          "name": "Device",
          "description": "Sofar device (alternative to choosing the inverter)."
        }
      }
    },
    "clear_slots": {
      "name": "Clear slots",
      "description": "Remove one or all Home Assistant-driven slots.",
      "fields": {
        "config_entry_id": {
          "name": "Inverter",
          "description": "Leave empty if you only have one."
        },
        "slot_id": {
          "name": "Slot ID",
          "description": "Leave empty to clear all."
        },
        "device_id": {
          "name": "Device",
          "description": "Sofar device (alternative to choosing the inverter)."
        }
      }
    },
    "set_timing_slot": {
      "name": "Set inverter timing slot",
      "description": "Write one of the inverter's 4 built-in timing slots (runs on the inverter even if Home Assistant is down).",
      "fields": {
        "config_entry_id": {
          "name": "Inverter",
          "description": "Leave empty if you only have one."
        },
        "slot": {
          "name": "Slot",
          "description": "1–4. Lower number wins when slots overlap."
        },
        "charge_enabled": {
          "name": "Charge enabled",
          "description": "Enable the charge window."
        },
        "charge_start": {
          "name": "Charge start",
          "description": "HH:MM"
        },
        "charge_end": {
          "name": "Charge end",
          "description": "HH:MM"
        },
        "charge_power": {
          "name": "Charge power",
          "description": "W"
        },
        "discharge_enabled": {
          "name": "Discharge enabled",
          "description": "Enable the discharge window."
        },
        "discharge_start": {
          "name": "Discharge start",
          "description": "HH:MM"
        },
        "discharge_end": {
          "name": "Discharge end",
          "description": "HH:MM"
        },
        "discharge_power": {
          "name": "Discharge power",
          "description": "W"
        },
        "activate": {
          "name": "Switch to timing mode",
          "description": "Set the energy storage mode to Timing after writing."
        },
        "device_id": {
          "name": "Device",
          "description": "Sofar device (alternative to choosing the inverter)."
        }
      }
    },
    "set_tou_rule": {
      "name": "Set inverter time of use rule",
      "description": "Write one of the inverter's time of use charge rules (charge in a window up to a target SOC).",
      "fields": {
        "config_entry_id": {
          "name": "Inverter",
          "description": "Leave empty if you only have one."
        },
        "rule": {
          "name": "Rule",
          "description": "1–4. Lower number wins when rules overlap."
        },
        "enabled": {
          "name": "Enabled",
          "description": "Enable this rule."
        },
        "start": {
          "name": "Start",
          "description": "HH:MM"
        },
        "end": {
          "name": "End",
          "description": "HH:MM"
        },
        "target_soc": {
          "name": "Target SOC",
          "description": "Stop charging at this SOC (30–100)."
        },
        "power": {
          "name": "Charge power",
          "description": "W"
        },
        "weekdays": {
          "name": "Weekdays",
          "description": "Days the rule runs. Leave empty for every day."
        },
        "activate": {
          "name": "Switch to time of use mode",
          "description": "Set the energy storage mode to Time of use after writing."
        },
        "device_id": {
          "name": "Device",
          "description": "Sofar device (alternative to choosing the inverter)."
        }
      }
    }
  }
}