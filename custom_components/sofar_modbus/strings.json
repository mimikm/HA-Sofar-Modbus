{
  "config": {
    "step": {
      "user": {
        "title": "Sofar inverter via Modbus gateway",
        "description": "Enter the IP gateway's address. Use 'Modbus TCP' if the gateway converts Modbus TCP to RTU, or 'RTU over TCP' if it is in transparent mode (required for battery control on ME3000SP / HYD-ES). The integration then detects which Sofar model and features you have.",
        "data": {
          "name": "Name",
          "host": "Gateway IP address",
          "port": "Port",
          "slave": "Inverter Modbus address",
          "framing": "Gateway protocol"
        }
      },
      "reconfigure": {
        "title": "Reconfigure connection",
        "data": {
          "host": "Gateway IP address",
          "port": "Port",
          "slave": "Inverter Modbus address",
          "framing": "Gateway protocol"
        }
      },
      "confirm": {
        "title": "Inverter found",
        "description": "Detected: **{model}**\n\nSerial: {serial}\nFirmware: {firmware}\nRegisters in use: {registers}\n\nPress Submit to add it."
      }
    },
    "error": {
      "cannot_connect": "No answer from the inverter. Check IP/port, gateway protocol mode, serial settings (9600 8N1) and Modbus address.",
      "legacy_unsupported": "This Sofar answers on the older ME3000SP / HYD-ES protocol, which isn't supported yet (planned for v0.4)."
    },
    "abort": {
      "already_configured": "This inverter is already configured.",
      "reconfigure_successful": "Connection updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
          "scan_interval": "Polling interval (seconds)",
          "max_battery_power": "Maximum battery power (W)",
          "passive_keepalive": "Re-send passive set-points every poll (use with a passive timeout)",
          "auto_time_sync": "Keep inverter clock in sync (auto-correct drift over 30 s, at most hourly)",
          "battery_capacity": "Battery capacity (kWh, 0 = not set) – used for stored energy and Predbat"
        }
      }
    }
  },
  "selector": {
    "framing": {
      "options": {
        "tcp": "Modbus TCP (gateway converts to RTU)",
        "rtu_over_tcp": "RTU over TCP (transparent mode)"
      }
    }
  },
